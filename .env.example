NODE_ENV=development
PORT=4000
API_PREFIX=api
# Origin of this API, used to build local-driver media URLs.
PUBLIC_API_ORIGIN=http://localhost:4000
# Exact frontend origins, comma separated. Include www if served.
CORS_ORIGINS=http://localhost:3000

# --- Database ------------------------------------------------------------
# Utho: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://cicc:cicc_dev@localhost:5435/cicc
# false | true (encrypted, for a managed DB with a private CA; same as no-verify) | verify (also checks the certificate)
DATABASE_SSL=false

# --- Auth ----------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# Only send the session cookie over HTTPS. Must be true in production.
COOKIE_SECURE=false
# First admin account, created by `npm run seed`.
ADMIN_EMAIL=admin@council-icc.org
ADMIN_PASSWORD=ChangeMe-CICC-2026

# --- Media ---------------------------------------------------------------
# local: backend/uploads, for development. s3: Utho Object Storage.
STORAGE_DRIVER=local
S3_ENDPOINT=https://innoida.utho.io
S3_REGION=ap-south-in-noida-1
S3_BUCKET=your-bucket
S3_ACCESS_KEY=TEMP_UTHO_ACCESS_KEY
S3_SECRET_KEY=TEMP_UTHO_SECRET_KEY
# Public base URL for objects in the bucket, no trailing slash.
S3_PUBLIC_URL=https://innoida.utho.io/your-bucket

# --- Payments --------------------------------------------------------------
# PayPal (developer.paypal.com → Apps & Credentials). Use sandbox keys to test, then live.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Receiving addresses. A network is offered only when its address is set. Use addresses CICC
# controls; double-check them, because funds sent to a wrong address can't be recovered.
# One EVM address covers Ethereum, BNB Chain, Polygon, Arbitrum, Optimism, Base and Avalanche.
PAYMENT_ADDRESS_EVM=
PAYMENT_ADDRESS_BTC=
PAYMENT_ADDRESS_LTC=
PAYMENT_ADDRESS_DOGE=
PAYMENT_ADDRESS_SOL=
PAYMENT_ADDRESS_TRON=
PAYMENT_ADDRESS_XRP=
# Optional keys for the free public services used to verify payments (higher rate limits).
TRONGRID_API_KEY=
BLOCKCYPHER_TOKEN=
COINGECKO_API_KEY=

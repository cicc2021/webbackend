{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "lib": ["ES2022"], "outDir": "dist", "rootDir": "src",
    "declaration": false, "removeComments": true, "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "esModuleInterop": true, "sourceMap": true, "skipLibCheck": true,
    "strict": true, "strictPropertyInitialization": false, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  /// Disabled accounts can't sign in; kept instead of deleted so history stays attributable.
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  sessions     Session[]
}

/// One row per refresh token. Rotated tokens stay (revoked) so that reuse can be detected.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Every token descended from one login shares a family; reuse revokes the whole family.
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([familyId])
}

model Media {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  url       String
  filename  String
  mimeType  String
  size      Int
  alt       String   @default("")
  /// Original URL for imported files, so re-running the importer doesn't upload them twice.
  sourceUrl String?  @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
}

model StaffMember {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  designation String
  /// Heading the person is listed under on the team page, e.g. "Executive Board".
  group       String   @default("Team")
  country     String   @default("")
  email       String   @default("")
  phone       String   @default("")
  linkedin    String   @default("")
  location    String   @default("")
  bio         String   @default("")
  photoUrl    String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  /// Department page this person is listed on. Null means the main MHQ team page.
  pageId      String?  @db.Uuid
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  /// Stable key for imported rows, so re-imports update instead of duplicating.
  sourceKey   String?  @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([isPublished, sortOrder])
  @@index([pageId])
}

model EventCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String   @default("")
  color       String   @default("#eb3f43")
  sortOrder   Int      @default(0)
  events      Event[]
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

model Event {
  id            String              @id @default(uuid()) @db.Uuid
  title         String
  slug          String              @unique
  summary       String              @default("")
  /// Sanitized HTML.
  content       String              @default("")
  coverUrl      String              @default("")
  location      String              @default("")
  /// Venue wall-clock time, stored as if UTC and always formatted in UTC. An event at
  /// 5 PM in Dubai reads 5 PM to everyone, with no timezone conversion anywhere.
  startAt       DateTime            @db.Timestamptz(6)
  endAt         DateTime            @db.Timestamptz(6)
  /// Maximum attendees across the event. Null means unlimited.
  capacity      Int?
  isFeatured    Boolean             @default(false)
  status        PublishStatus       @default(DRAFT)
  categoryId    String?             @db.Uuid
  category      EventCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceId      Int?                @unique
  packages      EventPackage[]
  registrations EventRegistration[]
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  @@index([categoryId])
  @@index([status, startAt])
}

model EventPackage {
  id            String              @id @default(uuid()) @db.Uuid
  eventId       String              @db.Uuid
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  description   String              @default("")
  /// Null means "price on request".
  price         Decimal?            @db.Decimal(12, 2)
  currency      String              @default("EUR")
  features      String[]            @default([])
  capacity      Int?
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)
  registrations EventRegistration[]

  @@index([eventId])
}

model EventRegistration {
  id           String             @id @default(uuid()) @db.Uuid
  /// Human-friendly number; a sequence stays unique under concurrent inserts.
  reference    Int                @unique @default(autoincrement())
  eventId      String             @db.Uuid
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  packageId    String?            @db.Uuid
  package      EventPackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phone        String
  organization String             @default("")
  country      String             @default("")
  attendees    Int                @default(1)
  notes        String             @default("")
  status       RegistrationStatus @default(PENDING)
  /// Online payments for a priced package; a paid one confirms the registration.
  payments     Payment[]
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)

  @@unique([eventId, email])
  @@index([packageId])
  @@index([status, createdAt])
}

model PageCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String   @default("")
  sortOrder   Int      @default(0)
  pages       Page[]
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
}

model Page {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  slug           String
  /// Full URL path, derived from the parent chain. Cached so public lookups need one query.
  path           String        @unique
  excerpt        String        @default("")
  coverUrl       String        @default("")
  /// Ordered layout blocks. Sanitized on save, see common/blocks.ts.
  blocks         Json          @default("[]")
  status         PublishStatus @default(DRAFT)
  showInNav      Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String        @default("")
  seoDescription String        @default("")
  parentId       String?       @db.Uuid
  parent         Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Page[]        @relation("PageTree")
  categoryId     String?       @db.Uuid
  category       PageCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceId       Int?          @unique
  staff          StaffMember[]
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([parentId])
  @@index([categoryId])
  @@index([status, sortOrder])
}

model BlogCategory {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
}

model BlogPost {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  slug        String        @unique
  excerpt     String        @default("")
  /// Sanitized HTML.
  content     String        @default("")
  coverUrl    String        @default("")
  authorName  String        @default("CICC")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)
  categoryId  String?       @db.Uuid
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceId    Int?          @unique
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  @@index([categoryId])
  @@index([status, publishedAt])
}

/// Submissions from form blocks on pages: contact, membership, newsletter.
model Enquiry {
  id        String   @id @default(uuid()) @db.Uuid
  subject   String
  option    String   @default("")
  name      String
  email     String
  phone     String   @default("")
  message   String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([isRead, createdAt])
}

enum PaymentStatus {
  PENDING
  CONFIRMING
  PAID
  UNDERPAID
  FAILED
  EXPIRED
}

enum PaymentMethod {
  PAYPAL
  CRYPTO
}

/// One payment attempt. Amounts are verified by the server: PayPal by capturing the order through
/// PayPal's API, crypto by reading the transaction on its blockchain.
model Payment {
  id               String             @id @default(uuid()) @db.Uuid
  /// Human-friendly number, shown as CICC-PAY-000123.
  reference        Int                @unique @default(autoincrement())
  /// Hash of the secret only the payer's browser holds, so nobody else can act on this payment.
  secretHash       String
  email            String
  name             String             @default("")
  purpose          String
  /// What the payment is for, e.g. an event registration reference or an invoice number.
  externalRef      String             @default("")
  /// Set when the payment is for an event package; paying confirms that registration.
  registrationId   String?            @db.Uuid
  registration     EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  notes            String             @default("")
  fiatAmount       Decimal            @db.Decimal(12, 2)
  fiatCurrency     String
  status           PaymentStatus      @default(PENDING)
  method           PaymentMethod?
  /// Network id from payments/networks.ts, e.g. ethereum, bitcoin, solana.
  network          String?
  asset            String?
  /// Quoted amount in the asset's smallest unit (wei, satoshi, …), as a string: it can exceed 64 bits.
  expectedRaw      String?
  /// The same amount as shown to the payer, e.g. "0.012345".
  expectedAmount   String?
  /// Price of one unit of the asset in fiatCurrency when quoted.
  quotePrice       String?
  quoteExpiresAt   DateTime?          @db.Timestamptz(6)
  payToAddress     String?
  txHash           String?
  /// When the payer submitted txHash; a transaction still unfindable hours later is given up on.
  submittedAt      DateTime?          @db.Timestamptz(6)
  /// The wallet that sent the crypto, read from the chain.
  payerWallet      String?
  receivedRaw      String?
  confirmations    Int?
  paypalOrderId    String?            @unique
  paypalCaptureId  String?
  /// The PayPal account's email, which can differ from the email the payer typed.
  paypalPayerEmail String?
  failureReason    String             @default("")
  lastCheckedAt    DateTime?          @db.Timestamptz(6)
  paidAt           DateTime?          @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)

  /// A transaction can pay for only one payment.
  @@unique([network, txHash])
  @@index([status, createdAt])
  @@index([email])
  @@index([registrationId])
}
